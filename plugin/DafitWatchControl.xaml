<UserControl x:Class="User.DafitWatch.DafitWatchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="FieldName" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="110"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ GAUCHE : statut + configuration ═══ -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">

            <!-- Statut en direct -->
            <Border Background="#11FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="140">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtBpm" Text="--" FontSize="44" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Bottom"/>
                            <TextBlock Text=" bpm" FontSize="14" Opacity="0.6" Margin="0,0,0,9"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtZone" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotState" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtState" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtDevice" Opacity="0.6" FontSize="12" Margin="18,4,0,0"/>
                        <TextBlock x:Name="TxtStats" Opacity="0.6" FontSize="12" Margin="18,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnApply" Content="Enregistrer et (re)connecter" Click="BtnApply_Click"/>
                <Button x:Name="BtnDisconnect" Content="Déconnecter" Click="BtnDisconnect_Click"/>
                <Button x:Name="BtnReset" Content="Remettre les stats à zéro" Click="BtnReset_Click"/>
            </StackPanel>

            <!-- Montre -->
            <TextBlock Text="MONTRE" Style="{StaticResource Lbl}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="Adresse :" Style="{StaticResource FieldName}"/>
                <TextBox x:Name="TxtAddress" Width="170"/>
                <TextBlock Text="  vide = recherche par nom" Opacity="0.4" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Nom :" Style="{StaticResource FieldName}"/>
                <TextBox x:Name="TxtName" Width="170"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="110,6,0,0">
                <Button x:Name="BtnScan" Content="Rechercher les montres" Click="BtnScan_Click"/>
                <TextBlock x:Name="TxtScan" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <ListBox x:Name="ListScan" Height="110" Margin="110,6,0,0" Visibility="Collapsed"
                     Background="#0DFFFFFF" Foreground="White" BorderBrush="#33FFFFFF"
                     FontFamily="Consolas" SelectionChanged="ListScan_SelectionChanged"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.5" FontSize="11" Margin="110,6,0,0">
                La montre n'accepte qu'une connexion : ferme l'app Da Fit (ou coupe le Bluetooth du téléphone) avant de connecter le PC.
            </TextBlock>

            <!-- Sport -->
            <TextBlock Text="MODE SPORT (NÉCESSAIRE POUR LE CARDIO EN CONTINU)" Style="{StaticResource Lbl}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="Sport lancé :" Style="{StaticResource FieldName}"/>
                <ComboBox x:Name="CmbSport" Width="200" DisplayMemberPath="Value" SelectedValuePath="Key"/>
            </StackPanel>
            <CheckBox x:Name="ChkStopOnExit" Margin="110,6,0,0"
                      Content="Arrêter le sport sur la montre en fermant SimHub"/>
            <CheckBox x:Name="ChkAutoConnect" Margin="110,4,0,0"
                      Content="Se connecter automatiquement au démarrage de SimHub"/>

            <!-- Cardio -->
            <TextBlock Text="CARDIO" Style="{StaticResource Lbl}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="FC max :" Style="{StaticResource FieldName}"/>
                <TextBox x:Name="TxtMaxHr" Width="60"/>
                <TextBlock Text=" bpm  (pour le % et les zones ; à défaut ≈ 220 − âge)" Opacity="0.4"
                           FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Péremption :" Style="{StaticResource FieldName}"/>
                <TextBox x:Name="TxtStale" Width="60"/>
                <TextBlock Text=" s sans mesure avant que HeartRate repasse à 0" Opacity="0.4"
                           FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtError" Foreground="#FF6B6B" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ═══ DROITE : propriétés exposées ═══ -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="PROPRIÉTÉS SIMHUB" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,0,0,8">
                Préfixe : DafitWatchPlugin.  — utilisables dans Dash Studio, les formules NCalc/JS
                et les autres plugins (PluginManager.GetPropertyValue).
            </TextBlock>
            <TextBlock FontFamily="Consolas" FontSize="11.5" Opacity="0.85" LineHeight="18">
                <Run Text="HeartRate"/><Run Text="          bpm (0 si pas de mesure)" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="HeartRateValid"/><Run Text="     true / false" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="HeartRatePercent"/><Run Text="   % de la FC max" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="HeartRateZone"/><Run Text="      0 à 5" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="Min/Avg/MaxHeartRate"/><Run Text=" session" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="DataAge"/><Run Text="            s depuis la mesure" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="Connected"/><Run Text="          true / false" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="State"/><Run Text="              Streaming, …" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="StatusText"/><Run Text="         texte lisible" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="Battery"/><Run Text="            % (‑1 inconnu)" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="DeviceName"/><Run Text="         nom de la montre" Foreground="#99FFFFFF"/><LineBreak/>
                <Run Text="UserMaxHeartRate"/><Run Text="   FC max réglée" Foreground="#99FFFFFF"/>
            </TextBlock>
            <TextBlock Text="ACTIONS" Style="{StaticResource Lbl}"/>
            <TextBlock FontFamily="Consolas" FontSize="11.5" Opacity="0.85" LineHeight="18">
                <Run Text="DafitWatchPlugin.Reconnect"/><LineBreak/>
                <Run Text="DafitWatchPlugin.ResetStats"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
